{
  "name": "dsh-desktop-shortcut",
  "version": "0.2.6",
  "description": "DeepSeek Harness plugin: creates a Windows desktop shortcut that launches dsh web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuyue521/dsh-desktop-shortcut.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {},
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "desktop",
    "shortcut",
    "windows"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  }
}
